---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  publishedAt?: Date;
  label: string;
  tags?: string[];
  repository?: string;
  website?: string;
}

const { title, description, publishedAt, label, tags = [], repository, website } = Astro.props;
const date = publishedAt && new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(publishedAt);
---

<BaseLayout title={`${title} — Pratyush Kiran`} description={description}>
  <article class="article page-shell">
    <header class="article-header">
      <a class="back-link" href={label === 'Project' ? '/work' : label === 'Journal' ? '/log' : '/writing'}>← Back to {label === 'Project' ? 'work' : label === 'Journal' ? 'log' : 'writing'}</a>
      <p class="section-kicker">{label}{date ? ` · ${date}` : ''}</p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      {tags.length > 0 && <div class="tag-list">{tags.map((tag) => <span>{tag}</span>)}</div>}
      {(repository || website) && (
        <div class="article-actions">
          {repository && <a href={repository} target="_blank" rel="noreferrer">GitHub <Icon name="github" size={16} /></a>}
          {website && <a href={website} target="_blank" rel="noreferrer">Live project <Icon name="external" size={15} /></a>}
        </div>
      )}
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
