---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('logs', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'logs'> };
const { Content } = await render(entry);
---

<ArticleLayout title={entry.data.title} description={entry.data.summary} publishedAt={entry.data.publishedAt} label="Journal" tags={entry.data.themes}>
  <Content />
</ArticleLayout>
