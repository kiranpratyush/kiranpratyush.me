---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const date = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout title="Writing — Pratyush Kiran" description="Essays about backend engineering, distributed systems, databases, and system internals.">
  <div class="page-shell archive-page narrow-archive">
    <header class="page-intro">
      <p class="section-kicker">Writing / {entries.length.toString().padStart(2, '0')}</p>
      <h1 class="page-title">Writing</h1>
      <p>Longer explanations of ideas I have tested, systems I have studied, and lessons I want to remember.</p>
    </header>
    <div class="archive-list">
      {entries.length > 0 ? entries.map((entry, index) => (
          <a href={`/writing/${entry.id}/`}>
            <span class="archive-index">0{index + 1}</span>
            <div><time>{date.format(entry.data.publishedAt)}</time><h2>{entry.data.title}</h2><p>{entry.data.description}</p><small>{entry.data.tags.join(' · ')}</small></div>
            <Icon name="external" size={17} />
          </a>
        )) : (
          <div class="coming-soon">
            <strong>Blogs coming soon.</strong>
            <span>I&apos;m working on the first one.</span>
          </div>
        )}
    </div>
  </div>
</BaseLayout>
